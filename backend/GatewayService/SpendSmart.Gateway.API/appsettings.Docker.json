{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "authUsersRoute": {
        "ClusterId": "authCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "categoryRoute": {
        "ClusterId": "categoryCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "expenseRoute": {
        "ClusterId": "expenseCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/expenses/{**catch-all}" }
      },
      "incomeRoute": {
        "ClusterId": "incomeCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/incomes/{**catch-all}" }
      },
      "budgetRoute": {
        "ClusterId": "budgetCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/budgets/{**catch-all}" }
      },
      "reportRoute": {
        "ClusterId": "reportCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notificationRoute": {
        "ClusterId": "notificationCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "adminRoute": {
        "ClusterId": "authCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "notificationHubRoute": {
        "ClusterId": "notificationCluster",
        "CorsPolicy": "Default",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": { "dest1": { "Address": "https://auth-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "categoryCluster": {
        "Destinations": { "dest1": { "Address": "https://category-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "expenseCluster": {
        "Destinations": { "dest1": { "Address": "https://expense-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "incomeCluster": {
        "Destinations": { "dest1": { "Address": "https://income-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "budgetCluster": {
        "Destinations": { "dest1": { "Address": "https://budget-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "reportCluster": {
        "Destinations": { "dest1": { "Address": "https://report-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      },
      "notificationCluster": {
        "Destinations": { "dest1": { "Address": "https://notification-service.internal.nicewater-707ce070.eastasia.azurecontainerapps.io/" } }
      }
    }
  }
}
