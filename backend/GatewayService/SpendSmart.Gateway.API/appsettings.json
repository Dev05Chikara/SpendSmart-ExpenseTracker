{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "authUsersRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "categoryRoute": {
        "ClusterId": "categoryCluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "expenseRoute": {
        "ClusterId": "expenseCluster",
        "Match": { "Path": "/api/expenses/{**catch-all}" }
      },
      "incomeRoute": {
        "ClusterId": "incomeCluster",
        "Match": { "Path": "/api/incomes/{**catch-all}" }
      },
      "budgetRoute": {
        "ClusterId": "budgetCluster",
        "Match": { "Path": "/api/budgets/{**catch-all}" }
      },
      "reportRoute": {
        "ClusterId": "reportCluster",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notificationRoute": {
        "ClusterId": "notificationCluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5184/" } }
      },
      "categoryCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5004/" } }
      },
      "expenseCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5002/" } }
      },
      "incomeCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5003/" } }
      },
      "budgetCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5005/" } }
      },
      "reportCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5006/" } }
      },
      "notificationCluster": {
        "Destinations": { "dest1": { "Address": "http://localhost:5007/" } }
      }
    }
  }
}
