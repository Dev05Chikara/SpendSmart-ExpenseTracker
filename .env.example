# =============================================================
# SpendSmart — Docker Compose Environment Variables
# IMPORTANT: Never commit real secrets to version control.
#            Copy this file to .env and fill in your values.
# =============================================================

# SQL Server SA password (must meet SQL Server complexity requirements)
# Minimum 8 chars, mix of uppercase, lowercase, digit, and special char
SA_PASSWORD=SpendSmart_SA_Pass2024!

# Shared JWT secret — must be the same string across ALL services
# Use at least 32 characters; generate with: openssl rand -base64 32
JWT_KEY=SpendSmartSuperSecretKey_ChangeMe_InProd_32chars!

# JWT config
JWT_ISSUER=SpendSmart
JWT_AUDIENCE=SpendSmartUsers

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=453747910306-vid0si72gek01g9839mje46vm6m8tmpj.apps.googleusercontent.com

# Admin seed account (only used on first startup)
SEED_ADMIN_EMAIL=admin@spendsmart.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_FULLNAME=Administrator
